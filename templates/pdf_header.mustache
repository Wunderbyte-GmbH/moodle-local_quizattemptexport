{{!
    @template local_quizattemptexport/pdf_header

    Header table at the top of an exported attempt. Included by pdf_base.

    Context variables required for this template:
    * coursename - Course name.
    * coursecode - Optional enrolment key of the user.
    * quizname - Quiz name.
    * studentname - Name of the user the attempt belongs to.
    * matriculationid - The user's ID number.
    * attemptstarted - Start of the attempt, formatted.
    * attemptended - End of the attempt, formatted.
    * attemptresult - Result of the attempt, formatted.

    Example context (json):
    {
        "coursename": "Mathematics 101",
        "coursecode": "MATH101",
        "quizname": "Final exam",
        "studentname": "Jane Doe",
        "matriculationid": "123456",
        "attemptstarted": "05.11.2026 - 09:00:00",
        "attemptended": "05.11.2026 - 10:00:00",
        "attemptresult": "8.00 / 10.00 (80 %)"
    }
}}
<table class="reportheader">
    <tr>
        <th>{{#str}}label_coursename, local_quizattemptexport{{/str}}</th>
        <td>{{{coursename}}}</td>
    </tr>
    <tr>
        <th>{{#str}}label_quizname, local_quizattemptexport{{/str}}</th>
        <td>{{{quizname}}}</td>
    </tr>
    <tr>
        <th>{{#str}}label_studentname, local_quizattemptexport{{/str}}</th>
        <td>{{{studentname}}}</td>
    </tr>
    <tr>
        <th>{{#str}}label_matriculationid, local_quizattemptexport{{/str}}</th>
        <td>{{{matriculationid}}}</td>
    </tr>
    {{#coursecode}}
    <tr>
        <th>{{#str}}label_coursecode, local_quizattemptexport{{/str}}</th>
        <td>{{{coursecode}}}</td>
    </tr>
    {{/coursecode}}
    <tr>
        <th>{{#str}}label_attemptstarted, local_quizattemptexport{{/str}}</th>
        <td>{{{attemptstarted}}}</td>
    </tr>
    <tr>
        <th>{{#str}}label_attemptended, local_quizattemptexport{{/str}}</th>
        <td>{{{attemptended}}}</td>
    </tr>
    <tr>
        <th>{{#str}}label_attemptresult, local_quizattemptexport{{/str}}</th>
        <td>{{{attemptresult}}}</td>
    </tr>
</table>
