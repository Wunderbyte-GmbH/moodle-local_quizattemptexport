<?xml version="1.0"?>
<libraries>
    <library>
        <location>vendor/knplabs/knp-snappy</location>
        <name>Snappy</name>
        <description>PHP wrapper for wkhtmltopdf, used to render quiz attempts as PDF.</description>
        <version>1.7.3</version>
        <license>MIT</license>
        <repository>https://github.com/KnpLabs/snappy</repository>
    </library>
    <library>
        <location>vendor/symfony/process</location>
        <name>Symfony Process</name>
        <description>Runs wkhtmltopdf as a sub process. Required by Snappy.</description>
        <version>6.4.49</version>
        <license>MIT</license>
        <repository>https://github.com/symfony/process</repository>
    </library>
    <library>
        <location>vendor/mathjax/mathjax</location>
        <name>MathJax</name>
        <description>Renders mathematical notation in the exported attempts.</description>
        <version>2.7.9</version>
        <license>Apache-2.0</license>
        <repository>https://github.com/mathjax/MathJax</repository>
    </library>
    <library>
        <location>vendor/h4cc/wkhtmltopdf-amd64</location>
        <name>wkhtmltopdf amd64</name>
        <description>wkhtmltopdf binary for Linux amd64.</description>
        <version>0.12.4</version>
        <license>LGPL-3.0</license>
        <repository>https://github.com/h4cc/wkhtmltopdf-amd64</repository>
    </library>
    <library>
        <location>vendor/wemersonjanuario/wkhtmltopdf-windows</location>
        <name>wkhtmltopdf Windows</name>
        <description>wkhtmltopdf binary for Windows.</description>
        <version>0.12.2.3</version>
        <license>LGPL-3.0</license>
        <repository>https://github.com/wemersonjanuario/wkhtmltopdf-windows</repository>
    </library>
    <library>
        <location>vendor/composer</location>
        <name>Composer autoloader</name>
        <description>Class autoloader generated by Composer for the libraries above.</description>
        <version>2.11.1</version>
        <license>MIT</license>
        <repository>https://github.com/composer/composer</repository>
    </library>
    <library>
        <location>vendor/autoload.php</location>
        <name>Composer autoload entry point</name>
        <description>Loads the Composer autoloader for the libraries above.</description>
        <version>2.11.1</version>
        <license>MIT</license>
        <repository>https://github.com/composer/composer</repository>
    </library>
</libraries>
